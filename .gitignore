# ── PII / personal data (never commit real candidate facts) ─────────────────
# Local source of truth — copy from *.example.yaml after clone.
data/profile.yaml
data/profile.generated.yaml
data/profile.suggested.yaml
# Backups / variants hold the same data as the original (`.bak`, `.bak-DATE`, `.orig`…).
data/profile.yaml.*
data/portals.yaml.*
data/companies.yaml.*
data/source_catalog.yaml.*
data/form_knowledge.yaml.*
data/recruiters.yaml.*
data/**/*.bak
data/**/*.bak-*
data/**/*.orig
# Owner stamp: a hash that ties this data/ + output/ to one candidate.
data/.jobbot-owner.json
# Extra candidates (test CVs) live in their own workspace: never their data.
/sandboxes/
data/portals.yaml
data/companies.yaml
# Imported source catalog: share the researched seed (data/sources-*.example.yaml) instead.
data/source_catalog.yaml
# What application forms ask, observed locally. Questions only, but not shared.
data/form_knowledge.yaml
data/hard-link-inbox.txt
data/url-candidates.txt
# Hiring-practice sources you read; share the practices via `recruiters export`.
data/recruiters.yaml
# Answers profile.yaml does not hold (language level, contract, pay): local only.
data/application_answers.yaml
data/application_answers.yaml.*

# Keep sanitized templates tracked
!data/profile.example.yaml
!data/portals.example.yaml
!data/companies.example.yaml
!data/companies-cl.example.yaml
!data/sources-cl.example.yaml

# Private CV sources (LaTeX/PDF). Real moderncv stays private.
# Tracked: latex/cv.tex.demo + latex/README.md only.
latex/**
!latex/README.md
!latex/**/*.demo
# Anchored to the repo root: unanchored `cv/` also matched src/jobbot/cv (source code).
/cv/
/vitae/
/legacy/
/private/
data/**/*.tex
data/**/*.pdf
*.pdf
!tests/fixtures/**

# Accidental local .tex drops (Jinja templates + test fixtures stay tracked)
/*.tex
!templates/
!templates/**
!tests/fixtures/*.tex

# LaTeX build junk if someone compiles in-tree
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv

# ── Runtime / secrets / sessions ────────────────────────────────────────────
# Opt-in password vault (next to profile.yaml). Hidden ≠ encrypted; mode 0600.
data/.vault.yaml
data/.vault.yml
**/.vault.yaml
**/.vault.yml
browser-data/
output/
.env
.jobbot.toml
*.sqlite
*.db
*.sqlite3
credentials.json
**/cookies*.json
*.pem
*.key
id_rsa*
.openai_api_key

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# ── Tooling caches ──────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── OS / editor / local agent config ────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
# Editor-specific agent config stays local; AGENTS.md is tracked so remote
# agents working on an issue read the same policy as the local ones.
.cursor/

# ── Temporary scaffolding (never version) ───────────────────────────────────
tmp/
_chunks/
_put_*/
_update_args/
coverage.json
junit.xml
.local/
site/
